# ============================================================
# AXIOM — Autonomous E-Commerce Intent & Revenue Recovery Engine
# Copy this file to `.env` for local customization:
#   cp .env.example .env
# ============================================================

# ── FastAPI Autonomous Engine ──
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ── Autonomous Loop Cadence (Seconds) ──
EVENT_INTERVAL=2.0
INTENT_INTERVAL=5.0
MARKET_INTERVAL=10.0
OPP_INTERVAL=8.0

# ── Next.js Frontend Configuration ──
# Leave empty in local development to use Next.js built-in `/api/*` rewrite proxy
NEXT_PUBLIC_API_URL=

# ── Optional Production PostgreSQL Adapter (Defaults to built-in SQLite if unset) ──
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=axiom_production
# DB_USER=postgres
# DB_PASSWORD=your_secure_password_here
